# Copy this file to .env and fill in real values before starting the server.

# Port the API listens on
PORT=4000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Where the SQLite database file lives. Make sure this path is on persistent
# disk if you deploy to a host with an ephemeral filesystem.
DB_PATH=./data/sme.db

# Comma-separated list of allowed browser origins for CORS, e.g.
#   CORS_ORIGIN=https://your-app.example.com,https://staging.example.com
# Use * only for local development.
CORS_ORIGIN=*
